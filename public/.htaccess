Options -MultiViews -Indexes

RewriteEngine On

# Block hidden files
RewriteRule (^\.|/\.) - [F,L]

# Handle Authorization Header (needed for API/Bearer tokens)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# File Manager — serve index.php directly for subdirectory
RewriteRule ^file_manager/public/?$ file_manager/public/index.php [L,QSA]

# Send all non-file, non-directory requests to front controller
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
