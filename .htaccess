Options -Indexes -MultiViews

RewriteEngine On

# Block dotfiles
RewriteRule (^\.|/\.) - [F,L]

# File Manager
RewriteRule ^file_manager/public/?$ public/file_manager/public/index.php [L,QSA]

# Route everything else to front controller
# In per-directory context (live server), erp/ prefix is already stripped
# At project root (local dev), full URL is matched
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ public/index.php [L,QSA]
