Options -Indexes -MultiViews

RewriteEngine On

# ── Block access to hidden files (dotfiles) — must come first ────────────────
RewriteRule (^\.|/\.) - [F,L]

# ── File Manager (special entry point) ──────────────────────────────────────
RewriteRule ^(erp/)?file_manager/public/?$ public/file_manager/public/index.php [L,QSA]

# ── Static assets: /erp/assets/... → public/assets/...
# Works when .htaccess is at project root (local dev)
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^erp/(.+)$ public/$1 [L,QSA]

# ── Static assets: serve from public/ when .htaccess is inside erp/ ──────────
# When server DocumentRoot is public_html/ and .htaccess sits in public_html/erp/,
# per-directory context strips the erp/ prefix. Only match file-extension paths
# (js, css, png, etc.) so PHP routes like /login are never affected.
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI} !-f
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI} !-d
RewriteCond %{DOCUMENT_ROOT}/erp/public/$1 -f
RewriteRule ^(.+\.[a-zA-Z0-9]+)$ public/$1 [L]

# ── Route everything else (including /erp and /erp/*) through front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [L,QSA]
