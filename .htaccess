Options -Indexes -MultiViews

RewriteEngine On

# ── Block access to hidden files (dotfiles) — must come first ────────────────
RewriteRule (^\.|/\.) - [F,L]

# ── File Manager (special entry point) ──────────────────────────────────────
RewriteRule ^(erp/)?file_manager/public/?$ public/file_manager/public/index.php [L,QSA]

# ── Static assets from public/ ──────────────────────────────────────────────

# Case A: .htaccess at project root (local dev), path includes erp/ prefix
# e.g., erp/js/tailwindcss.js → public/js/tailwindcss.js
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^erp/(.+)$ public/$1 [L]

# Case B: .htaccess inside erp/ subdirectory (live server), path is relative
# e.g., js/tailwindcss.js → public/js/tailwindcss.js
RewriteCond %{DOCUMENT_ROOT}/erp/public/$1 -f
RewriteRule ^(.+)$ public/$1 [L]

# ── Route everything else through front controller ──────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [L,QSA]
